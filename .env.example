# ==============================================================================
# Oracle@Google Onboarding Agent — LLM & MCP Server Configuration
# Copy this file to `.env` or export the variables in your shell.
# NEVER commit `.env` with real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Vertex AI / Google Cloud ADC (Recommended for Enterprise Customers)
# Requires: `gcloud auth application-default login` and `aiplatform.googleapis.com`
# ------------------------------------------------------------------------------
ODB_AGENT_AUTH_MODE="vertex"
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="global"

# ------------------------------------------------------------------------------
# OPTION 2: Gemini Developer API Key (Quick Evaluation / AI Studio)
# Set ODB_AGENT_AUTH_MODE="api_key" and provide GEMINI_API_KEY
# ------------------------------------------------------------------------------
# ODB_AGENT_AUTH_MODE="api_key"
# GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# Configurable Gemini Model ID
# Customers can set ANY current or future Gemini model ID here (or via GEMINI_MODEL)
# so they are never stuck if a preview model is renamed or retired.
# Presets: gemini-3.8-flash (default), gemini-2.5-flash, gemini-2.5-pro, gemini-3.1-pro-preview
# ------------------------------------------------------------------------------
ODB_AGENT_MODEL="gemini-3.8-flash"
# GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# Workspace Containment & MCP Fast Validation Settings
# ODB_WORKSPACE_ROOT restricts all file writes and Day-2 inspections to the open workspace.
# ODB_FAST_VALIDATION="1" skips slow `terraform init` provider downloads for IDE MCP responsiveness.
# ------------------------------------------------------------------------------
# ODB_WORKSPACE_ROOT="/path/to/your/workspace"
# ODB_FAST_VALIDATION="1"

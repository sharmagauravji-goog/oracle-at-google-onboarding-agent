{
  "servers": {
    "oracle-at-google-onboarding-agent": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "ai_agent.mcp_server"
      ],
      "env": {
        "ODB_WORKSPACE_ROOT": "${workspaceFolder}",
        "ODB_AGENT_MODEL": "gemini-3.8-flash",
        "ODB_FAST_VALIDATION": "1"
      }
    }
  }
}
